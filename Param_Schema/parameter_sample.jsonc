        "system_year": 2024,
        "value": 11294,
        "raw_euromod_value": "11294#y"
      }
    },
    {
      "value": 11496,
      "valid_from": "2025-01-01",
      "valid_to": null,
      "legal_status": null,
      "source_type": null,
      "official_journal_date": null,
