      "comparison": {
        "model_release": "J2.19",
        "system_year": 2025,
        "model_value": 11496,
        "proposed_value": 11497,
        "difference": 1,
        "status": "requires_review"
      }
    }
  ],

  // [HUMAN REVIEW]
  // Append-only. An empty array means that the proposal is pending.
  "review_decisions": [
    {
      "proposal_id": "proposal-fr-tin-upthres1-2025-001",
      "decision": "needs_revision",
      "reviewed_by": "reviewer-id",
