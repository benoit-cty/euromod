# Copy to the repo root .env (the worker container reads it through env_file; the
# packages load it from the repo root and Nomoscope-agentic-workflow/) and adjust.
# Provider keys belong on the machine that runs the worker and nowhere else (ADR 0004).

# Legislation DB (docker compose up -d at the repo root)
WORKFLOW_DATABASE_URL=postgresql://jrc:jrc@localhost:5434/legislation

# Model, "<provider>/<name>". mock/extractor needs no API key (demo).
#   anthropic/claude-sonnet-5        needs ANTHROPIC_API_KEY
#   openai/gpt-5.2                   needs OPENAI_API_KEY
#   azure_openai/<deployment>        needs AZURE_OPENAI_* + OPENAI_API_VERSION; the name after
#                                    the slash is the Azure deployment (AZURE_OPENAI_DEPLOYMENT
#                                    is only a default for a bare "azure_openai", never an override)
#   openrouter/<vendor/model>        needs OPENROUTER_API_KEY
#   together/<vendor/model>          needs TOGETHER_API_KEY
#   jrc/<served model name>          JRC's own OpenAI-compatible gateway: needs JRC_LLM_BASE_URL (+ JRC_LLM_API_KEY)
WORKFLOW_MODEL=mock/extractor
#JRC_LLM_BASE_URL=https://llm.internal.jrc/v1
#JRC_LLM_API_KEY=<token issued by the gateway>
# Optional different model for the critique pass:
#WORKFLOW_CRITIQUE_MODEL=anthropic/claude-haiku-4-5

# Embeddings: 99 = deterministic placeholder shipped with the seed corpus (demo),
# 1 = bge-m3. WORKFLOW_ENCODER selects where the query vector comes from:
#   db          an `encode` job answered by the worker's warm encoder (what the
#               worker sets for the runs it executes; the UI does the same)
#   subprocess  the ingest package's local encoder (uv run --extra embeddings, for
#               a developer running the pipeline by hand without a worker)
# Encoder unavailable -> FTS-only fallback with one console note.
WORKFLOW_EMBEDDING_MODEL_ID=99
#WORKFLOW_ENCODER=db
WORKFLOW_RETRIEVAL_K=15

# Gap-fill scout on not_found: off | llm | tavily. Discovers the official
# instrument that sets a missing value (llm: ids the model is certain of;
# tavily: + web search restricted to official domains, ids harvested from
# result URLs) and ingests it archive-first via Nomotheca before one retry.
# Web text is never used as evidence — only the ingested corpus is.
WORKFLOW_SCOUT=off
#TAVILY_API_KEY=tvly-...
WORKFLOW_SCOUT_MAX_INGEST=2

# Observability — Arize Phoenix (docker compose service "phoenix")
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=nomoscope-agentic-workflow
WORKFLOW_TRACING=true

# Environmental impact (`nomoscope-workflow impact`, UI Impact tab, eval energy KPI):
# EcoLogits over the Phoenix span token counts. Defaults: phoenix DB in the same
# Postgres as WORKFLOW_DATABASE_URL; electricity mix EEE = Europe (WOR = world).
#PHOENIX_DATABASE_URL=postgresql://jrc:jrc@localhost:5434/phoenix
#ECOLOGITS_ELECTRICITY_MIX_ZONE=EEE

# Worker (Nomergon-worker; see its README). The models an analyst may pick, first is
# the default; the worker publishes them in ops.worker_models at startup.
WORKER_MODELS=mock/extractor,azure_openai/gpt-5.6-luna
#WORKER_DATABASE_URL=postgresql://jrc:jrc@localhost:5434/legislation   # defaults to WORKFLOW_DATABASE_URL
#WORKER_EMBEDDING_MODEL_PATH=BAAI/bge-m3
#WORKER_POLL_SECONDS=1
