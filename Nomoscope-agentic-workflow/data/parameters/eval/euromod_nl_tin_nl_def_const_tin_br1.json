{
  "information": {
    "country": "NL",
    "model_target": "euromod://NL/tin_nl/def_const/$tin_br1",
    "spine_order": "22",
    "value_type": "scalar",
    "unit": "/1",
    "threshold_unit": null,
    "label": {
      "en": "bandrate1"
    },
    "short_label": {
      "en": "$tin_br1"
    },
    "description": {
      "en": "$tin_br1 ('bandrate1', latest 8.1%) is the rate of the lowest band of the Box 1 income tax schedule, which in the Netherlands combines income tax with national insurance ('volksverzekeringen') contributions; it matches the Country Report's Table 2.28 'tax_rate1' row (9.42% in 2022 falling to 8.17% in 2025). It is used directly as the first band_rate in tin_nl/SchedCalc's 'Tax schedule for income from Box 1', and is reused three further times in bsagross_nl: in an ArithOp formula recalculating 'Revised income tax' when net social assistance (bsa00_s) is revised, in a BenCalc comp_perElig splitting the share of a taxpayer's tax credits attributable to the national-insurance-premium component, and as an input to the DefConst $bsag_fact net-to-gross conversion factors used to gross up net social assistance (see bsagross.md, Table 2.10 'Factor 1')."
    },
    "explanation": {
      "en": "EUROMOD function group: tax rates - income tax"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
