    "model_target": "euromod://FR/tinty_fr/def_const/$tintadp_amt",
    "spine_order": "26",
    "value_type": "scalar",
    "unit": "currency/year",
    "threshold_unit": null,
    "label": {
      "en": "Deduction for major children and dependent relatives"
    },
    "short_label": {
      "en": "$tintadp_amt"
    },
    "description": {
      "en": "A fixed annual allowance a tax household ('foyer fiscal') can deduct from taxable income for each adult child or ascendant relative attached to it outside the standard family-quotient mechanism (e.g. an adult child or dependent parent living with the household); latest value €4,075, with 19 recorded historical values back to 2006. It is used in tinty_fr's BenCalc function (comp_perElig parameter, \"Calculate tax allowance for ascendants & children over 18\"). Theme_doc taxes.md confirms: \"Fixed deduction for ascendants or major children living in the household (€4,075)\" for the latest year (up from €4,039 previously), consistent with cr:tin.md's description of the foyer fiscal as the taxpayer plus fiscally dependent persons, which can include children over 18 or other dependants under specific conditions."
    },
    "explanation": {
      "en": "EUROMOD function group: Parameters for determining net taxable income (RNI)"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "income_year"
  },
