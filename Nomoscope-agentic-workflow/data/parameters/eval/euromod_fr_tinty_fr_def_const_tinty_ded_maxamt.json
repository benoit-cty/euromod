    "country": "FR",
    "model_target": "euromod://FR/tinty_fr/def_const/$tinty_ded_maxamt",
    "spine_order": "26",
    "value_type": "scalar",
    "unit": "currency/year",
    "threshold_unit": null,
    "label": {
      "en": "Maximum deduction for earnings"
    },
    "short_label": {
      "en": "$tinty_ded_maxamt"
    },
    "description": {
      "en": "This is the maximum ceiling (14,426 EUR for 2025) on the 10% flat-rate deduction ('abattement') applied to earned income (category C1) under the French personal income tax. It is used in policy tinty_fr in the BenCalc computing 'Tax deductions/allowances for C1 income' as the upper limit (comp_uplim). This matches the theme note and the Country Report's Table 2.70, which show the earned-income deduction ceiling rising to €14,426 in 2025 (from €14,171 in 2024)."
    },
    "explanation": {
      "en": "EUROMOD function group: Parameters for determining net taxable income (RNI)"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "income_year"
  },
