{
  "information": {
    "country": "FR",
    "model_target": "euromod://FR/ConstDef_fr/def_const/$bunmt_amt",
    "spine_order": "3",
    "value_type": "scalar",
    "unit": "currency/day",
    "threshold_unit": null,
    "label": {
      "en": "ASS daily benefit amount"
    },
    "short_label": {
      "en": "$bunmt_amt"
    },
    "description": {
      "en": "Daily benefit amount for the Allocation de Solidarité Spécifique (ASS), the unemployment assistance benefit paid to jobseekers who have exhausted their unemployment insurance (ARE) rights, were employed at least 5 years in the last 10, are under the eligibility age, able to work, and actively seeking a job. It is defined in the general constants policy (ConstDef_fr) and used in bunmt_fr's BenCalc function (Comp_Cond parameter, commented 'Benefit amount') as the daily rate underlying the benefit: the monthly amount equals this daily figure times 30 when the couple's net taxable income is below the full-rate threshold (40x the daily amount for a single person, 80x for a couple), and is reduced pound-for-pound above that threshold up to the income ceiling (70x/110x the daily amount). The value 19.48 EUR/day corresponds to the 2026 rate, up from 19.33 EUR/day in 2025."
    },
    "explanation": {
      "en": "EUROMOD function group: Unemployment benefits: bunmt"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
