    "value_type": "scalar",
    "unit": "currency/day",
    "threshold_unit": null,
    "label": {
      "en": "ASS daily benefit amount: FYA  (17.21+17.9)/2"
    },
    "short_label": {
      "en": "$bunmt_amt"
    },
    "description": {
      "en": "This is the flat daily benefit amount for ASS (Allocation de Solidarité Spécifique, Unemployment Assistance), expressed as a full-year-average (FYA) value of 19.33 EUR/day for 2025 (averaging half-year rates 17.21 and 17.9). It is used in bunmt_fr/BenCalc (parameter Comp_Cond) to compute the ASS benefit amount. The policy documentation for ASS directly confirms a daily amount of 19.33 EUR for 2025 (monthly = 30 x daily), paid to claimants who exhausted ARE unemployment insurance entitlement, worked 5 of the last 10 years, and are under 62."
    },
    "explanation": {
      "en": "EUROMOD function group: Unemployment benefits: bunmt"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
