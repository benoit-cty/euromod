    "country": "NL",
    "model_target": "euromod://NL/bsanet_nl/def_const/$bsa_single_nonret_amt",
    "spine_order": "27",
    "value_type": "scalar",
    "unit": "currency/month",
    "threshold_unit": null,
    "label": {
      "en": "amount for single person, non pension age (50% of standard amount)"
    },
    "short_label": {
      "en": "$bsa_single_nonret_amt"
    },
    "description": {
      "en": "Monthly social assistance base amount for a single person below state pension age; the modeller's label notes it as '50% of standard amount', and it is used alongside the identically-valued $bsa_single_lone_nonret_amt in the same BenCalc computation (comp_perTU, 'Social Assistance benefit amount for single people') in bsanet_nl. It corresponds to the 'Single persons, 21-s.p.a.' row of the country report's Table 2.11 (€1,345.45 in January 2025); the exact functional distinction from $bsa_single_lone_nonret_amt is not documented in the sources beyond both feeding the same calculation."
    },
    "explanation": {
      "en": "EUROMOD function group: Social Assistance: amounts (CR Table 2.9/2.11) No holiday-allowance!?"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
