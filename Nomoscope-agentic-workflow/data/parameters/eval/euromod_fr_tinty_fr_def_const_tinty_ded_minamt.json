    "model_target": "euromod://FR/tinty_fr/def_const/$tinty_ded_minamt",
    "spine_order": "26",
    "value_type": "scalar",
    "unit": "currency/year",
    "threshold_unit": null,
    "label": {
      "en": "Minimum deduction for earnings"
    },
    "short_label": {
      "en": "$tinty_ded_minamt"
    },
    "description": {
      "en": "This is the minimum floor (504 EUR for 2025) on the 10% flat-rate deduction applied to earned income (category C1) under the French personal income tax, guaranteeing at least this deductible amount per earner even if 10% of earnings is smaller. It is used in policy tinty_fr in the BenCalc computing 'Tax deductions/allowances for C1 income' as the lower limit (Comp_LowLim). This matches the theme note and the Country Report's Table 2.70, which show the earned-income deduction floor rising to €504 in 2025 (from €495 in 2024)."
    },
    "explanation": {
      "en": "EUROMOD function group: Parameters for determining net taxable income (RNI)"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "income_year"
  },
