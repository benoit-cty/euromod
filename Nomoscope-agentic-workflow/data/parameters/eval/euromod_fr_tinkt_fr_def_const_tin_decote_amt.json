    "model_target": "euromod://FR/tinkt_fr/def_const/$tin_decote_amt",
    "spine_order": "28",
    "value_type": "scalar",
    "unit": "currency",
    "threshold_unit": null,
    "label": {
      "en": "Base amount for the tax rebate (decote)"
    },
    "short_label": {
      "en": "$tin_decote_amt"
    },
    "description": {
      "en": "Base amount (for a single person) used to compute the non-refundable French income-tax rebate known as the \"décote\", set at 889 EUR for 2025 (Table 2.81 of the Country Report). It is used as the Comp_perTU parameter in the BenCalc functions of both tin_fr (personal income tax) and tinkt_fr (capital income tax), which compute the Décote as this fixed amount minus 45.25% of the gross tax liability (since 2020); the rebate reduces gross tax to zero once it exceeds this base amount less the applicable share of tax due."
    },
    "explanation": {
      "en": "EUROMOD function group: Paramteres of the income tax"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "income_year"
  },
