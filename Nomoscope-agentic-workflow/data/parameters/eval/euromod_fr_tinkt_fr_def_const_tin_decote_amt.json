    "model_target": "euromod://FR/tinkt_fr/def_const/$tin_decote_amt",
    "spine_order": "28",
    "value_type": "scalar",
    "unit": "currency/year",
    "threshold_unit": null,
    "label": {
      "en": "Base amount for the tax rebate (decote)"
    },
    "short_label": {
      "en": "$tin_decote_amt"
    },
    "description": {
      "en": "The base amount (single-taxpayer case) used to compute the décote, a non-refundable tax rebate that reduces gross income tax for low/moderate-liability tax units. It feeds Comp_perTU in the \"Tax rebate (Decote)\" BenCalc of both tin_fr and tinkt_fr, where the rebate equals this amount minus a fraction of gross tax liability (see $tin_decote_rate). It corresponds to the single-person row of the country report's Table 2.81 \"tax rebate parameter for calculation\", a series uprated roughly annually since 2006."
    },
    "explanation": {
      "en": "EUROMOD function group: Paramteres of the income tax"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "income_year"
  },
