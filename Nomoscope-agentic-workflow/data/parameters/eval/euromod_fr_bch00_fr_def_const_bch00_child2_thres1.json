    "country": "FR",
    "model_target": "euromod://FR/bch00_fr/def_const/$bch00_child2_thres1",
    "spine_order": "29",
    "value_type": "scalar",
    "unit": "currency",
    "threshold_unit": null,
    "label": {
      "en": "Income threshold to receive full rate for families with 2 children"
    },
    "short_label": {
      "en": "$bch00_child2_thres1"
    },
    "description": {
      "en": "This constant is the annual household resource (Revenu Net Catégoriel, n-2 income) ceiling below which a two-child family receives the AF universal child benefit at the full rate, set at €78,565 for 2025 per Table 2.5 of the country report and the benefits note. It is used in bch00_fr/BenCalc as the Comp_Cond condition determining the total benefit amount, i.e. whether the family qualifies for the full, 50%, or 25% rate. Together with $bch00_child2_thres2, it defines the income bands for the means test that applies to AF and its over-14 increment (means-tested since 1 July 2015)."
    },
    "explanation": {
      "en": "EUROMOD function group: Constants"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
