    "model_target": "euromod://FR/bch00_fr/def_const/$bch00_child2_thres1",
    "spine_order": "29",
    "value_type": "scalar",
    "unit": "currency/year",
    "threshold_unit": null,
    "label": {
      "en": "Income threshold to receive full rate for families with 2 children"
    },
    "short_label": {
      "en": "$bch00_child2_thres1"
    },
    "description": {
      "en": "This constant is the annual income ceiling, based on the household's Revenu Fiscal de Reference (RFR, n-2 reference fiscal income), below which a family with 2 dependent children receives France's universal family benefit (Allocation Familiale, AF) at the full rate. It is used in policy bch00_fr's BenCalc function via the Comp_Cond parameter ('Total benefit amount') when computing the total, means-tested benefit amount. The country report's Table 2.5 shows this threshold rising over time (e.g. 78,565 EUR in 2025), and the France benefits documentation gives 79,980 for 2026, matching this constant's latest value; households above it instead receive 50% (up to $bch00_child2_thres2) or 25% of the base amount, under the RFR-based means test introduced 1 July 2015."
    },
    "explanation": {
      "en": "EUROMOD function group: Constants"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
