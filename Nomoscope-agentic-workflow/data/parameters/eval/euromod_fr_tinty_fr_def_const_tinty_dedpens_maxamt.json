    "model_target": "euromod://FR/tinty_fr/def_const/$tinty_dedpens_maxamt",
    "spine_order": "26",
    "value_type": "scalar",
    "unit": "currency/year",
    "threshold_unit": null,
    "label": {
      "en": "Maximum deduction for pension income"
    },
    "short_label": {
      "en": "$tinty_dedpens_maxamt"
    },
    "description": {
      "en": "This is the maximum ceiling (4,399 EUR for 2025) on the 10% flat-rate deduction applied to pension income under the French personal income tax. It is used in policy tinty_fr in the BenCalc computing 'Tax deductions/allowances for C1 income' as the upper limit (comp_uplim), specifically for the pension component of category C1. This matches the theme note and the Country Report's Table 2.70, which show the pension deduction ceiling rising to €4,399 in 2025 (from €4,321 in 2024)."
    },
    "explanation": {
      "en": "EUROMOD function group: Parameters for determining net taxable income (RNI)"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "income_year"
  },
