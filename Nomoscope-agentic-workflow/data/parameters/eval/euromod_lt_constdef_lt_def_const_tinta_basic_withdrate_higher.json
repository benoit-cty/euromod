    "threshold_unit": null,
    "label": {
      "en": "basic allowance: the withdraw rate of basic allowance for people with income below $tinta_basic_thres"
    },
    "short_label": {
      "en": "$tinta_basic_WithdRate_Higher"
    },
    "description": {
      "en": "Sets the marginal withdrawal-rate coefficient (labelled 'coef' in the country report's basic-allowance Equation 1) that reduces the basic personal-income-tax allowance as income rises above the first threshold, under the formula in force since 2022. Its value has moved from 0.26 (2022) to 0.42 (2023) to 0.5 (2024) to 0.49 (2025, its latest recorded value), matching Table 2.16 of the country report exactly. It is used as the Withdraw_Rate parameter of the BenCalc components computing the basic allowance in tin_admn_lt ('post 2022 formula') and tin_lt (final tax liability, since 2009)."
    },
    "explanation": {
      "en": "EUROMOD function group: personal income tax (PIT): general parameters"
    },
