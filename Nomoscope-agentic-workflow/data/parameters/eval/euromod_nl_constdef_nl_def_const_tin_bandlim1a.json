    "country": "NL",
    "model_target": "euromod://NL/constdef_nl/def_const/$tin_bandlim1a",
    "spine_order": "3",
    "value_type": "scalar",
    "unit": "currency/year",
    "threshold_unit": null,
    "label": {
      "en": "alternative limit for elderly persons"
    },
    "short_label": {
      "en": "$tin_bandlim1a"
    },
    "description": {
      "en": "This constant is the elevated, alternative upper limit of income-tax/peoples'-insurance 'band 1' that applies to the small, closed transitional cohort of taxpayers born before 1 January 1946, instead of the standard limit $tin_bandlim1 (defined in constdef_nl). It feeds into InitVar_nl's BenCalc as the comp_perTU value of the component whose eligibility condition uses the age threshold $tin_lim1lft, so members of this older cohort are assigned the higher ceiling rather than the standard one. The Country Report documents the same distinction (Table 2.28 'band1 (born before 1-1-1946)' = €40,502 in 2025; Table 2.24 'pi_maxbase when born before 1-1-1946' = €40,502), so this constant's later value of €41,123 is consistent with continued annual uprating of that grandfathered threshold."
    },
    "explanation": {
      "en": "EUROMOD function group: Income tax: band_limits"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
