    "threshold_unit": null,
    "label": {
      "en": "1 share higher threshold for median rate"
    },
    "short_label": {
      "en": "$tscxc_thres5"
    },
    "description": {
      "en": "This is the RFR (reference tax income) threshold — 26,004 EUR for 2025 — for a single-share tax unit, above which pension income moves from the reduced CSG rate to the median CSG rate (below the full standard rate of 8.3%), part of the graduated CSG-on-pensions schedule. It is used in policy tinty_fr in the ArithOp that 'calculates the applicable threshold for median rate for pensions', paired with $tscxc_thres6 (the per-additional-half-share increment)."
    },
    "explanation": {
      "en": "EUROMOD function group: Parameters for determining net taxable income (RNI)"
    },
