{
  "information": {
    "country": "NL",
    "model_target": "euromod://NL/constdef_nl/def_const/$MinWage_m",
    "spine_order": "3",
    "value_type": "scalar",
    "unit": "currency/month",
    "threshold_unit": null,
    "label": {
      "en": "monthly minimum wage;without holiday-allowance (added in 11.4) ; "
    },
    "short_label": {
      "en": "$MinWage_m"
    },
    "description": {
      "en": "$MinWage_m as defined in the country's central constants policy (constdef_nl) represents the monthly gross statutory minimum wage, with a comment added at EUROMOD version 11.4 noting this instance specifically as the variant excluding the 8% holiday allowance. In the current NL model this defining instance is not populated for the latest date (recorded value is \"n/a\"); the live figure under the same constant name is instead supplied by the parallel $MinWage_m defined in policy yem_nl (id 48, currently EUR 2,294.40/month). Through this shared name the constant feeds four spine calculations: bma_nl's BenCalc (parameter Comp_perTU) sets the monthly Pregnancy and Childbirth Allowance for self-employed claimants equal to the minimum wage (per the country report, \"for self-employed, the benefit equals the minimum wage\"); poa_nl's ArithOp uses 15% of it as the earnings disregard in the flat-rate State Pension (AOW)'s means test on a younger spouse's income; psu_nl's ArithOp uses 50% of it as the earnings disregard in the Survivor Benefit (ANW) income test; and yem_nl's own ArithOp combines it with a holiday-allowance rate to build a minimum-wage-plus-holiday-allowance figure."
    },
    "explanation": {
      "en": "EUROMOD function group: Minimum wage"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
