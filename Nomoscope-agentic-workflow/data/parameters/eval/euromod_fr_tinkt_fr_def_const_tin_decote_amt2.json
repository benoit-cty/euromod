    "threshold_unit": null,
    "label": {
      "en": "Base amount of decote for couples since 2015"
    },
    "short_label": {
      "en": "$tin_decote_amt2"
    },
    "description": {
      "en": "Base amount of the décote (tax rebate) applicable to couples (married or PACS) since the 2015 reform, set at 1470 EUR for 2025 (Table 2.81). Like $tin_decote_amt for singles, it feeds the Comp_perTU parameter of the \"Tax rebate (Decote)\" BenCalc computations in tin_fr and tinkt_fr, where it is reduced by 45.25% of gross tax liability to give the rebate amount for tax units taxed jointly as a couple."
    },
    "explanation": {
      "en": "EUROMOD function group: Paramteres of the income tax"
    },
