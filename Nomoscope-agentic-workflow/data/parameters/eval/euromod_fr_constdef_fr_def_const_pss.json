  "information": {
    "country": "FR",
    "model_target": "euromod://FR/ConstDef_fr/def_const/$PSS",
    "spine_order": "3",
    "value_type": "scalar",
    "unit": "currency/year",
    "threshold_unit": null,
    "label": {
      "en": "PSS: Plafond Annuel de la Sécurité Sociale"
    },
    "short_label": {
      "en": "$PSS"
    },
    "description": {
      "en": "$PSS ('Plafond Annuel de la Sécurité Sociale') is France's official annual social-security earnings ceiling, defined once in ConstDef_fr and used as a scaling constant at 33 sites across the FR spine — the single most widely referenced constant in this batch. Examples include tinty_fr/DefConst, which uses it to build the $csg_red_thres threshold for determining net taxable income (RNI) in the personal income tax module, and tscse_fr, which uses PSS multiples throughout the self-employed contribution schedule: as the SchedCalc lower limit for the artisan/industry-and-trade 'MAIN' pension-insurance band, as the BenCalc eligibility condition for artisan sickness-insurance contributions, and in the artisan professional-training-contribution formula. The Country Report (tscse.md, Table 2.63) documents PSS rising from €41,136 in 2022 to €47,100 in 2025; the model's latest value of €48,060 continues this annual uprating, and multiples of PSS (1×, 1.1×, 1.4×, 4×, 5×) define almost every self-employed contribution income band described in the report's Table 2.64."
    },
    "explanation": {
      "en": "EUROMOD function group: Income limits for SIC purposes"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
