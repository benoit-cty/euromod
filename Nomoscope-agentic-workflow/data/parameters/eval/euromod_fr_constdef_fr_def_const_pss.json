  "information": {
    "country": "FR",
    "model_target": "euromod://FR/ConstDef_fr/def_const/$PSS",
    "spine_order": "3",
    "value_type": "scalar",
    "unit": "currency/year",
    "threshold_unit": null,
    "label": {
      "en": "PSS: Plafond Annuel de la Sécurité Sociale"
    },
    "short_label": {
      "en": "$PSS"
    },
    "description": {
      "en": "PSS is the annual 'Plafond de la Sécurité Sociale' (Social Security Ceiling), the reference income ceiling used throughout the French social-insurance-contribution (SIC) system to define contribution bands and thresholds. In the model it feeds $csg_red_thres in tinty_fr/DefConst (parameters used to determine net taxable income, RNI, for CSG/CRDS purposes) and, via tscse_fr, the artisans' professional training contribution formula, the sickness-insurance eligibility condition for artisans, and the lower limit of the artisans'/industry-and-trade pension-insurance contribution band. Its 2025/26 annual value of 47,100 EUR is internally consistent with the monthly PSS of 3,925 EUR used to build the $tsc_group1_lim/$tsc_groupA_lim complementary-pension income limits (1x monthly PSS)."
    },
    "explanation": {
      "en": "EUROMOD function group: Income limits for SIC purposes"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
