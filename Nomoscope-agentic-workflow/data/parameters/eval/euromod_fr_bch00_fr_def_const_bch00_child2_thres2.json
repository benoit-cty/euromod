    "model_target": "euromod://FR/bch00_fr/def_const/$bch00_child2_thres2",
    "spine_order": "29",
    "value_type": "scalar",
    "unit": "currency/year",
    "threshold_unit": null,
    "label": {
      "en": "Income threshold to receive half rate for families with 2 children"
    },
    "short_label": {
      "en": "$bch00_child2_thres2"
    },
    "description": {
      "en": "This constant is the upper annual RFR income ceiling for 2-child families under France's universal family benefit (Allocation Familiale, AF): households with income between $bch00_child2_thres1 and this threshold receive AF at the half (50%) rate, while those above it receive only 25% of the base amount. It is used alongside $bch00_child2_thres1 in policy bch00_fr's BenCalc function via the Comp_Cond parameter ('Total benefit amount'), which computes the total means-tested benefit. The country report's Table 2.5 documents the equivalent 2025 threshold at 104,719 EUR; this constant's latest value of 106,604 EUR continues that year-on-year progression into 2026."
    },
    "explanation": {
      "en": "EUROMOD function group: Constants"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
