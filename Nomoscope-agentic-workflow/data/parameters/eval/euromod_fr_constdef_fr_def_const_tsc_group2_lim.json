{
  "information": {
    "country": "FR",
    "model_target": "euromod://FR/ConstDef_fr/def_const/$tsc_group2_lim",
    "spine_order": "3",
    "value_type": "scalar",
    "unit": "currency/month",
    "threshold_unit": null,
    "label": {
      "en": "Income limits for SIC purposes: 3*monthly PSS"
    },
    "short_label": {
      "en": "$tsc_group2_lim"
    },
    "description": {
      "en": "This is an income ceiling for social insurance contribution (SIC) purposes equal to three times the monthly PSS (11,775 EUR/month for 2025/26), corresponding to the 'Tranche 2' (non-cadre/blue-collar) contribution band under the French complementary pension system (AGIRC-ARRCO). It is used across tscee_fr/BenCalc (parameter Comp_perElig, the AGFF contribution), tscee_fr/SchedCalc (parameter Band_UpLim, complementary insurance for non-white-collar employees) and tscer_fr/BenCalc (parameter Comp_perTU, the employer AGFF old-age contribution). This is not covered by the available benefits theme document, but its value (3x the $tsc_group1_lim ceiling) is internally consistent with the model's PSS-based contribution band structure."
    },
    "explanation": {
      "en": "EUROMOD function group: Income limits for SIC purposes"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
