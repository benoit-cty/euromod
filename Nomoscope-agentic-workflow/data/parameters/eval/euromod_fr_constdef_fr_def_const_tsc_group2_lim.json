{
  "information": {
    "country": "FR",
    "model_target": "euromod://FR/ConstDef_fr/def_const/$tsc_group2_lim",
    "spine_order": "3",
    "value_type": "scalar",
    "unit": "currency/month",
    "threshold_unit": null,
    "label": {
      "en": "Income limits for SIC purposes: 3*monthly PSS"
    },
    "short_label": {
      "en": "$tsc_group2_lim"
    },
    "description": {
      "en": "$tsc_group2_lim is the monthly income ceiling set at 3 times the monthly PSS (Plafond de la Securite Sociale, the French social-security reference ceiling), marking the upper bound of 'Income group 2' used for social-insurance-contribution (SIC) purposes. In tscee_fr/SchedCalc it is the Band_UpLim of the non-white-collar complementary-pension band ('Complementary insurance for non white collar'), and it also bounds the AGFF contribution formula (Comp_perElig) in tscee_fr/BenCalc and the employer-side AGFF component (Comp_perTU, 'AGFF (old age)') in tscer_fr/BenCalc. Per the FR country report (Table 2.56), Income group 2 spans 1x to 3x the monthly PSS (2025: 3,925 to 11,775 EUR); the constant's current value (12,015 EUR) implies a later, higher monthly PSS (about 4,005 EUR) than the report's 2025 figure."
    },
    "explanation": {
      "en": "EUROMOD function group: Income limits for SIC purposes"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
