    "threshold_unit": null,
    "label": {
      "en": "1 share higher threshold for reduced rate"
    },
    "short_label": {
      "en": "$tscxc_thres3"
    },
    "description": {
      "en": "This is the RFR (reference tax income) threshold — 16,755 EUR for 2025 — for a single-share tax unit, above the exemption level but below which pension income is taxed at the reduced CSG rate rather than the median or full rate, part of the graduated CSG-on-pensions schedule. It is used in policy tinty_fr in the ArithOp that 'calculates the applicable threshold for reduced rate for pensions', paired with $tscxc_thres4 (the per-additional-half-share increment)."
    },
    "explanation": {
      "en": "EUROMOD function group: Parameters for determining net taxable income (RNI)"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
