    "threshold_unit": null,
    "label": {
      "en": "1 share higher threshold for reduced rate"
    },
    "short_label": {
      "en": "$tscxc_thres3"
    },
    "description": {
      "en": "Represents the RFR (revenu fiscal de référence) threshold for one fiscal share above which pension income moves out of the reduced ('taux réduit') CSG band; latest value €17,057/year, with 13 recorded values since 2006. It is used in tinty_fr's ArithOp (Formula) annotated 'Calculate applicable threshold for reduced rate for pensions', alongside $tscxc_thres4 which supplies the per-half-share increment. This is consistent with the theme documentation's note that the CSG rate on pensions 'varies based on income' (Table 2.65), the reduced rate being one of the intermediate bands between exemption and the full rate."
    },
    "explanation": {
      "en": "EUROMOD function group: Parameters for determining net taxable income (RNI)"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
