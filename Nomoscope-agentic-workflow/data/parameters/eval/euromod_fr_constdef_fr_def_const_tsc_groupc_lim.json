{
  "information": {
    "country": "FR",
    "model_target": "euromod://FR/ConstDef_fr/def_const/$tsc_groupC_lim",
    "spine_order": "3",
    "value_type": "scalar",
    "unit": "currency/month",
    "threshold_unit": null,
    "label": {
      "en": "Income limits for SIC purposes: 8* montly PSS"
    },
    "short_label": {
      "en": "$tsc_groupC_lim"
    },
    "description": {
      "en": "$tsc_groupC_lim is the monthly income ceiling set at 8 times the monthly PSS, the upper bound of 'Income group C', the top earnings band for white-collar complementary-pension contributions. It is the final Band_UpLim in tscee_fr/SchedCalc ('Complementary insurance for white collar'), caps the base used in the employer-side outstanding/technical-equilibrium contribution formula (CET) in tscer_fr/ArithOp, and is also referenced in the employer's main old-age insurance formula in tscer_fr/BenCalc. Per the country report (Table 2.56), Income group C spans 4x to 8x the monthly PSS (2025: 15,700 to 31,400 EUR); the CET (Contribution d'Equilibre Technique, introduced with the 2019 AGIRC-ARRCO merger) applies across the combined income groups A/B/C up to this ceiling. The constant's current value (32,040 EUR) implies a later, higher monthly PSS than the report's 2025 figure."
    },
    "explanation": {
      "en": "EUROMOD function group: Income limits for SIC purposes"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
