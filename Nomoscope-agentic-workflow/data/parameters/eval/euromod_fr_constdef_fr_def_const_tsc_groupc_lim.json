{
  "information": {
    "country": "FR",
    "model_target": "euromod://FR/ConstDef_fr/def_const/$tsc_groupC_lim",
    "spine_order": "3",
    "value_type": "scalar",
    "unit": "currency/month",
    "threshold_unit": null,
    "label": {
      "en": "Income limits for SIC purposes: 8* montly PSS"
    },
    "short_label": {
      "en": "$tsc_groupC_lim"
    },
    "description": {
      "en": "This is an income ceiling for social insurance contribution (SIC) purposes equal to eight times the monthly PSS (31,400 EUR/month for 2025/26), corresponding to the 'Tranche C' (cadre/white-collar) contribution band under the French complementary pension system (AGIRC-ARRCO). It is used in tscee_fr/SchedCalc (parameter Band_UpLim, complementary insurance for white-collar employees), tscer_fr/ArithOp (parameter Formula, computing the outstanding CET — Contribution Exceptionnelle et Temporaire — for the complementary pension) and tscer_fr/BenCalc (parameter Comp_perTU, the main old-age insurance contribution). This is not covered by the available benefits theme document, but its value (8x the $tsc_group1_lim/$tsc_groupA_lim ceiling) is internally consistent with the model's PSS-based band structure."
    },
    "explanation": {
      "en": "EUROMOD function group: Income limits for SIC purposes"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
