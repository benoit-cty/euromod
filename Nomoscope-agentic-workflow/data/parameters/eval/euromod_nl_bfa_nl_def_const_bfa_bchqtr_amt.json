{
  "information": {
    "country": "NL",
    "model_target": "euromod://NL/bfa_nl/def_const/$bfa_bchqtr_amt",
    "spine_order": "14",
    "value_type": "scalar",
    "unit": "currency",
    "threshold_unit": null,
    "label": {
      "en": "The amounts of child benefit are all based on this amount; in 2006 177.89 euros per quarter; (CR table 2.4)"
    },
    "short_label": {
      "en": "$bfa_bchqtr_amt"
    },
    "description": {
      "en": "The quarterly base amount (per child) of the Dutch child benefit (kinderbijslag), from which all age-differentiated child-benefit amounts are derived. Per the Country Report (Table 2.4), this base rate is €286.45 per quarter per child as of 2025 and has been periodically uprated since the benefit was first modelled from 2006-01-01, when it stood at €177.89 per quarter (per the parameter label); the latest modelled value is €295.07 per quarter. In the bfa_nl policy it is used in an ArithOp formula whose comment marks it as the '2006' calculation for children over 12, i.e. an early version of the age-band amount computation that was later generalised via the age multipliers $bfa_mult1/$bfa_mult2/$bfa_mult3 (CR Table 2.5), which the label states are all applied on top of this same base figure."
    },
    "explanation": {
      "en": "EUROMOD function group: Constant"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
