    "spine_order": "26",
    "value_type": "scalar",
    "unit": "currency/year",
    "threshold_unit": null,
    "label": {
      "en": "Minimum deduction for unemployment benefits"
    },
    "short_label": {
      "en": "$tinty_dedbun_lowlim"
    },
    "description": {
      "en": "This is the minimum floor on the 10% flat-rate deduction applied specifically to unemployment benefit income within category C1 of the French personal income tax, currently set to 0 in the model. It is used in policy tinty_fr in the BenCalc computing 'Tax deductions/allowances for C1 income' as the lower limit (comp_lowlim). Neither source document gives a separate published floor for unemployment-benefit deductions distinct from the general earned-income floor, so the current zero value is inferred from the model rather than confirmed by the sources."
    },
    "explanation": {
      "en": "EUROMOD function group: Parameters for determining net taxable income (RNI)"
    },
