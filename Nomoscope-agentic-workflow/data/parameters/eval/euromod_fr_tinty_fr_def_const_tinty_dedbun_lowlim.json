    "spine_order": "26",
    "value_type": "scalar",
    "unit": "currency/year",
    "threshold_unit": null,
    "label": {
      "en": "Minimum deduction for unemployment benefits"
    },
    "short_label": {
      "en": "$tinty_dedbun_lowlim"
    },
    "description": {
      "en": "The floor on the deduction applied to unemployment-benefit income within the same category-1 income tax treatment as earnings and pensions; the latest value is €0, meaning no guaranteed minimum deduction currently applies to unemployment benefits, in contrast to the positive floors that apply to earnings ($tinty_ded_minamt, €509) and pensions ($tinty_dedpens_minamt, €454). It is used in tinty_fr's BenCalc function (comp_lowlim parameter, \"Tax deductions/ allowances for C1 income\"). The supplied theme_doc gives only combined figures for earned income and pensions without breaking out unemployment benefits, so this description relies on the constant's name, label, and its parallel role to the earnings/pension floor constants; the 12 recorded historical values suggest this floor changed over time before being set to zero."
    },
    "explanation": {
      "en": "EUROMOD function group: Parameters for determining net taxable income (RNI)"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
