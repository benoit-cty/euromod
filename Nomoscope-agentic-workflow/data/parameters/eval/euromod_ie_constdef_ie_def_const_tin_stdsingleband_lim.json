    "unit": "currency/year",
    "threshold_unit": null,
    "label": {
      "en": "Income tax: standard rate band for single persons (except lone parents)"
    },
    "short_label": {
      "en": "$tin_StdSingleband_lim"
    },
    "description": {
      "en": "This is the standard-rate income tax band for a single person (other than a lone parent), currently €44,000/year, matching the taxes theme doc's Table 15 entry: 'Standard-rate band: €44,000 (single)'. It is used twice in tin_ie: once in an ArithOp formula ('Single persons: standard rate band') to set the single-person band, and once as the val parameter of a Min function ('Married couples: increased standard rate band'), where it is combined with earnings to compute the maximum transferable band for married couples, since only one spouse's band can be increased up to this single-person amount."
    },
    "explanation": {
      "en": "EUROMOD function group: SICs and tax constants"
    },
