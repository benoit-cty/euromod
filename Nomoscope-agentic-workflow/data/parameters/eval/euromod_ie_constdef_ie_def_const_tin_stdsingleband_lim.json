    "model_target": "euromod://IE/ConstDef_ie/def_const/$tin_StdSingleband_lim",
    "spine_order": "3",
    "value_type": "scalar",
    "unit": "currency/year",
    "threshold_unit": null,
    "label": {
      "en": "Income tax: standard rate band for single persons (except lone parents)"
    },
    "short_label": {
      "en": "$tin_StdSingleband_lim"
    },
    "description": {
      "en": "Represents the width of the standard (lower) income-tax rate band for a single person who is not a lone parent. It is used directly in tin_ie's ArithOp (formula, comment 'Single persons: standard rate band') and, via a Min() function (comment 'Married couples: increased standard rate band'), as a cap on how much of a second earner's income can extend a jointly assessed married couple's band. The Country Report's Table 15 shows the single-person band rising from €36,800 (2022) to €44,000 (2025), matching the constant's latest value, consistent with the rule limiting the amount of standard-rate band transferable between spouses."
    },
    "explanation": {
      "en": "EUROMOD function group: SICs and tax constants"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
