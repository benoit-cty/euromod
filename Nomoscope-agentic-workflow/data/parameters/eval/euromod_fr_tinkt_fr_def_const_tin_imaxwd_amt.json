    "threshold_unit": null,
    "label": {
      "en": "Complementary reduction for widow/er with dependent child for whom an imax correction applies"
    },
    "short_label": {
      "en": "$tin_imaxwd_amt"
    },
    "description": {
      "en": "A further tax reduction granted to widow(er)s with at least one dependent child, on top of the family-ratio (Imax) correction, applied as Comp_perElig in the same \"Complementary reduction\" BenCalc of tin_fr and tinkt_fr as $tin_imaxdis_amt. It matches the \"Widower with dependent child\" row of the country report's Table 2.79 complementary-reduction amounts."
    },
    "explanation": {
      "en": "EUROMOD function group: Paramteres of the income tax"
    },
