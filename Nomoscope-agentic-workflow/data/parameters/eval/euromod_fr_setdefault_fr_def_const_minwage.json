    "country": "FR",
    "model_target": "euromod://FR/SetDefault_fr/def_const/$MinWage",
    "spine_order": "1",
    "value_type": "scalar",
    "unit": "currency/month",
    "threshold_unit": null,
    "label": {
      "en": "Statutory monthly gross minimum wage, 30th of June"
    },
    "short_label": {
      "en": "$MinWage"
    },
    "description": {
      "en": "$MinWage is the French statutory gross monthly minimum wage (SMIC), captured as of 30 June each year (currently €1,867.02) and defined once in SetDefault_fr as a system-wide wage benchmark for the FR spine. It is referenced in ConstDef_fr/DefConst when building $mc_yem_max, part of the parameter set for the COVID-19 wage-compensation schemes, and is used as the Comp_Cond eligibility condition in tscse_fr/BenCalc's self-employed 'Family benefits-SIC' contribution calculation. More broadly, French social-contribution rules frequently set contribution-rate cut-offs and relief thresholds as multiples of the minimum wage — the FR contributions documentation expresses several employer contribution-rate changes and the low-wage 'Réduction générale'/RGDU relief in terms of SMIC multiples — which is the general role $MinWage plays as a reference value elsewhere in the model."
    },
    "explanation": {
      "en": "EUROMOD function group: Min Wage"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
