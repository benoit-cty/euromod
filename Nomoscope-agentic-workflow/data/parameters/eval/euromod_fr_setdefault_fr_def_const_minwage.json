    "country": "FR",
    "model_target": "euromod://FR/SetDefault_fr/def_const/$MinWage",
    "spine_order": "1",
    "value_type": "scalar",
    "unit": "currency/month",
    "threshold_unit": null,
    "label": {
      "en": "Statutory monthly gross minimum wage, no FYA implemented"
    },
    "short_label": {
      "en": "$MinWage"
    },
    "description": {
      "en": "$MinWage is the French statutory gross monthly minimum wage (SMIC brut mensuel, based on the standard legal working time), with a latest modelled value of €1,801.80/month (no adjustment for a reduced first-year-of-activity rate is applied, per the modeller's comment). In the EUROMOD France spine it is used in ConstDef_fr's DefConst function to build the derived constant $mc_yem_max, part of a set of constants supporting the COVID-19 wage-compensation schemes, and it is also used as the Comp_Cond (compensation/eligibility condition) parameter in tscse_fr's BenCalc function, which computes the family-related social-insurance-contribution ('SIC') component. The FR benefits note does not quote the SMIC monthly figure directly but repeatedly uses SMIC as the reference wage for eligibility ceilings (e.g. child-earnings tests expressed as a share of SMIC), consistent with this constant's role as the general minimum-wage reference used across benefit rules."
    },
    "explanation": {
      "en": "EUROMOD function group: Min Wage"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
