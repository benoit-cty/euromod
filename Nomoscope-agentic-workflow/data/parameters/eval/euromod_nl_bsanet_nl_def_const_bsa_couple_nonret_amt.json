    "country": "NL",
    "model_target": "euromod://NL/bsanet_nl/def_const/$bsa_couple_nonret_amt",
    "spine_order": "27",
    "value_type": "scalar",
    "unit": "currency/month",
    "threshold_unit": null,
    "label": {
      "en": "amount for couples with children, non pension age (CR Table 2.11)"
    },
    "short_label": {
      "en": "$bsa_couple_nonret_amt"
    },
    "description": {
      "en": "Monthly base social assistance amount for a couple with children where neither partner has reached state pension age; the label explicitly cites the country report's Table 2.11. Used in bsanet_nl's BenCalc (comp_perTU, 'Social Assistance benefit amount for couples with children'). It shares the same base rate as couples without children (children's needs are met separately via child benefit/child-related budget rather than a higher BSA rate) - €1,922.07 in January 2025 per Table 2.11 - with the model's current value (€2,002.13/month) reflecting a later uprating."
    },
    "explanation": {
      "en": "EUROMOD function group: Social Assistance: amounts (CR Table 2.9/2.11) No holiday-allowance!?"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
