    "model_target": "euromod://FR/bch00_fr/def_const/$bch00_child3plus_thres",
    "spine_order": "29",
    "value_type": "scalar",
    "unit": "currency/year",
    "threshold_unit": null,
    "label": {
      "en": "Increase in income thresholds for each additional child after the third one"
    },
    "short_label": {
      "en": "$bch00_child3plus_thres"
    },
    "description": {
      "en": "This constant is the annual increment added to the household's RFR income threshold for each dependent child beyond the third, used in policy bch00_fr's BenCalc function via the Comp_Cond parameter ('Total benefit amount') to scale up the means-test thresholds for larger families when computing France's universal family benefit (Allocation Familiale, AF). The country report's Table 2.5 documents this increase rising from 5,839 EUR (2022) to 6,546 EUR (2025); this constant's latest value of 6,664 EUR/year matches the France benefits documentation's explicit 2026 figure ('thresholds increase by 6,664 EUR per additional child')."
    },
    "explanation": {
      "en": "EUROMOD function group: Constants"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
