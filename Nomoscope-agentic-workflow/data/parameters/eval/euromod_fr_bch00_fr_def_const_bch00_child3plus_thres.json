    "country": "FR",
    "model_target": "euromod://FR/bch00_fr/def_const/$bch00_child3plus_thres",
    "spine_order": "29",
    "value_type": "scalar",
    "unit": "currency",
    "threshold_unit": null,
    "label": {
      "en": "Increase in income thresholds for each additional child after the third one"
    },
    "short_label": {
      "en": "$bch00_child3plus_thres"
    },
    "description": {
      "en": "This constant is the amount by which the AF income-test thresholds increase for each additional dependent child beyond the third, equal to €6,546 in 2025 per Table 2.5 of the country report and the benefits note ('thresholds increase by €6,546 per additional child'). It is used in bch00_fr/BenCalc as the Comp_Cond condition determining the total benefit amount, raising the full-rate and reduced-rate income ceilings (built from $bch00_child3_thres1/$bch00_child3_thres2) for large families with more than three children. It is part of the household resource (Revenu Net Catégoriel) means test applied to the universal child benefit since July 2015."
    },
    "explanation": {
      "en": "EUROMOD function group: Constants"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
