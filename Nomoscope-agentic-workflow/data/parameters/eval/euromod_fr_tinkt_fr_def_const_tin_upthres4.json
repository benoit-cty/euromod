    "threshold_unit": null,
    "label": {
      "en": "Upper limit for band 4"
    },
    "short_label": {
      "en": "$tin_upthres4"
    },
    "description": {
      "en": "Upper income threshold of the fourth band (30% rate) of the progressive income tax schedule, set at 83 822 EUR for 2025 taxable income (Table 2.77, top of the 30% bracket). It is used as the Band_UpLim parameter in the tin_fr SchedCalc computing gross income tax and in tinkt_fr's Imax recalculation, marking where the 30% band ends and the 41% band ($tin_rate5) begins."
    },
    "explanation": {
      "en": "EUROMOD function group: Paramteres of the income tax"
    },
