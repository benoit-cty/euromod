  "information": {
    "country": "FR",
    "model_target": "euromod://FR/bdi_fr/def_const/$bdi_amt1",
    "spine_order": "36",
    "value_type": "scalar",
    "unit": "currency/month",
    "threshold_unit": null,
    "label": {
      "en": "Benefit amount per month: basic"
    },
    "short_label": {
      "en": "$bdi_amt1"
    },
    "description": {
      "en": "This is the monthly ceiling (maximum) amount of the AAH (Allocation aux adultes handicapés), France's means-tested disability benefit, paid to disabled adults with a permanent disability of at least 80%, or 50-80% combined with recognised unemployability. AAH is a differential benefit computed as (income threshold - income)/12, and this constant supplies the upper limit of that calculation in bdi_fr/BenCalc via the Comp_UpLim parameter, i.e. the cap a recipient can receive when their income is zero. The value of 1033.32 EUR/month matches the 2025 maximum monthly AAH amount reported in the Country Report (Table 2.24) and the policy-description note; the amount is uprated annually and, for years with mid-year increases (e.g. 2022), the modelled figure is a weighted average of the pre- and post-increase amounts via the FYA mechanism."
    },
    "explanation": {
      "en": "EUROMOD function group: Constants for disability benefit"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
