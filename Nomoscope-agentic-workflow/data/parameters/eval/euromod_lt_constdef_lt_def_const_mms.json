    "model_target": "euromod://LT/ConstDef_lt/def_const/$MMS",
    "spine_order": "3",
    "value_type": "scalar",
    "unit": "currency/month",
    "threshold_unit": null,
    "label": {
      "en": "Gross minimum monthly salary: tscsepi, tscsehl and tscer"
    },
    "short_label": {
      "en": "$MMS"
    },
    "description": {
      "en": "Gross minimum monthly salary (currently EUR 1223.33/month), a key statutory wage floor referenced at 18 sites across the LT spine. Per the benefits document it is the base for the constant component of the unemployment benefit (23.27% of MMS for months 1-3 in 2025, changing to 15% of MMS from July 2026), and it also underlies eligibility thresholds for social assistance ('lower limits applied on employment and self-employment income' in bsa00_lt/bsa_FYA_lt Elig_Cond) and the labour-market-activation add-on (TransLMA_lt/Elig). It is also referenced within ConstDef_lt when setting the $mc_max wage-compensation ceiling."
    },
    "explanation": {
      "en": "EUROMOD function group: Pension age, MMS, AMS, AMSp,  BSA, SSI, CYI, CBN, basic/asistance pensions bases, RP"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
