    "country": "ES",
    "model_target": "euromod://ES/ConstDef_es/def_const/$IPREM",
    "spine_order": "7",
    "value_type": "scalar",
    "unit": "currency/month",
    "threshold_unit": null,
    "label": {
      "en": "Index used for the calculation of social benefits (IPREM) - monthly"
    },
    "short_label": {
      "en": "$IPREM"
    },
    "description": {
      "en": "IPREM (Indicador Público de Renta de Efectos Múltiples) is Spain's official multi-purpose reference index for social-benefit eligibility thresholds and amounts, which replaced the minimum wage in this role in 2004; it is stored as a monthly value (600 EUR at the latest of 10 recorded observations since 2005-01-01). It is the most widely referenced constant in this batch, used across 13 sites: it sets ceilings, floors and eligibility tests in several bsarg_es regional minimum-income schemes (e.g. Castilla y León's benefit ceiling, Galicia's minimum cap, La Rioja's income/age eligibility check), drives the income-tiered payment rates of Andalucía's means-tested child benefit bchrg_es (120%/110%/100%/50% of the basic amount for family income up to 1/2/4/6 times IPREM), sets the large-family definition in bch00_es and the parental-benefit amount in bmanc_es, and fixes the statutory floor and ceiling of the contributory unemployment benefits bunct_es and bunct02_es (e.g. a floor of 80% of monthly IPREM, or 107% with a dependent child, and ceilings of 175%-225%, each increased by one sixth)."
    },
    "explanation": {
      "en": "EUROMOD function group: Constants: main"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
