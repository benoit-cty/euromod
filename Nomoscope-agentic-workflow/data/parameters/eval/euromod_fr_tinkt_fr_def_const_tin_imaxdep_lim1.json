  "information": {
    "country": "FR",
    "model_target": "euromod://FR/tinkt_fr/def_const/$tin_imaxdep_lim1",
    "spine_order": "28",
    "value_type": "scalar",
    "unit": "currency/year",
    "threshold_unit": null,
    "label": {
      "en": "Value of the first 2 half shares for dependents in QF"
    },
    "short_label": {
      "en": "$tin_imaxdep_lim1"
    },
    "description": {
      "en": "A cap used in the \"Plafonnement du quotient familial\" (family-ratio capping) mechanism, which limits the tax saving generated by the additional half-shares (parts) granted for dependents in the quotient familial. It is used as Comp_perTU in tinkt_fr's BenCalc under \"Imax: Limit on deductions claimed on behalf of dependents\". Its value and the roughly annual uprating pattern seen in the model's dated series line up with the country report's Table 2.78 cap on the first two additional half-shares, though the report's wording ties that specific row to lone parents rather than dependents generally."
    },
    "explanation": {
      "en": "EUROMOD function group: Paramteres of the income tax"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "income_year"
  },
