    "spine_order": "28",
    "value_type": "scalar",
    "unit": "currency/year",
    "threshold_unit": null,
    "label": {
      "en": "Value of the first 2 half shares for dependents in QF"
    },
    "short_label": {
      "en": "$tin_imaxdep_lim1"
    },
    "description": {
      "en": "Cap, for the first two half-shares (0.5 units) of family quotient (Quotient Familial, QF) granted for a lone parent, on the tax reduction resulting from the family-ratio system's extra weighting; set at 4224 EUR for 2025 (Table 2.78, 'the two first 0.5 for lone parent'). It is used as the Comp_perTU parameter in the tinkt_fr BenCalc step labelled \"Imax: Limit on deductions claimed on behalf of dependents\", part of the 'Plafonnement du quotient familial' correction that recomputes gross tax with a reduced QF (Imax) and caps the tax saving attributable to dependents."
    },
    "explanation": {
      "en": "EUROMOD function group: Paramteres of the income tax"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "income_year"
  },
