    "threshold_unit": null,
    "label": {
      "en": "Each 0.5 share higher threshold for reduced rate"
    },
    "short_label": {
      "en": "$tscxc_thres4"
    },
    "description": {
      "en": "Represents the amount added to the base one-share reduced-rate threshold ($tscxc_thres3) for each additional half fiscal share, so the CSG reduced-rate threshold for pension income scales with household composition; latest value €4,555/year, dating back to 2006. It is used together with $tscxc_thres3 in the tinty_fr ArithOp (Formula) commented 'Calculate applicable threshold for reduced rate for pensions'. As with the exemption-threshold pair, this reflects how French CSG income thresholds are expressed per 'part' of the quotient familial."
    },
    "explanation": {
      "en": "EUROMOD function group: Parameters for determining net taxable income (RNI)"
    },
