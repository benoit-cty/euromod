    "threshold_unit": null,
    "label": {
      "en": "basic allowance: the income from which higher basic allowance is withdrawn"
    },
    "short_label": {
      "en": "$tinta_higher_thres"
    },
    "description": {
      "en": "Defines the monthly income threshold, set equal to 100% of the minimum monthly salary ($MMS), at which the basic personal-income-tax allowance starts being withdrawn under the formula in force since 2022. It corresponds to the first threshold in the country report's Equation 1 (e.g. 1,038 EUR/month for 2025, the minimum monthly salary): below it the allowance stays at its maximum level ($tinta_max_amt), above it the allowance declines with income. It is used as the Withdraw_Start parameter of the BenCalc components computing the basic allowance in tin_admn_lt (post-2022 formula) and tin_lt (final tax liability, since 2009)."
    },
    "explanation": {
      "en": "EUROMOD function group: personal income tax (PIT): general parameters"
    },
