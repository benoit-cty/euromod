    "threshold_unit": null,
    "label": {
      "en": "30th of June"
    },
    "short_label": {
      "en": "$Minwage_hourly"
    },
    "description": {
      "en": "$Minwage_hourly is the gross hourly minimum wage (SMIC horaire brut). It is defined once in SetDefault_fr and reused across the spine as a threshold for dependent-child and eligibility tests: TUDef_fr/DefTu, bchlg_fr/DefTu and bhotn_fr/DefTu use it (via DepChildCond) to decide whether a child counts as a dependent — per bhotn.md and bch00.md, a child under 20 is dependent only if earning less than 55% of the minimum wage — while bch00_fr/BenCalc uses the same 55%-of-minimum-wage test to gate the fixed monthly amount paid to families with 3+ children when the eldest is 20 (bch00.md gives the resulting euro thresholds, e.g. 1104.25 EUR from April 2025). It is also used in bmact_fr/BenCalc and bpact_fr/BenCalc as part of a previous-insurance-record eligibility check, and in bsawk_fr/ArithOp to help compute the activity bonus (Prime d'Activite). The label '30th of June' appears to be an internal modeller note on the constant's update/reference date rather than a policy description."
    },
    "explanation": {
      "en": "EUROMOD function group: Min Wage"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
