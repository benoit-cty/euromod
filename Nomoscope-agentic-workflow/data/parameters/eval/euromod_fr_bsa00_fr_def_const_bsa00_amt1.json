    "country": "FR",
    "model_target": "euromod://FR/bsa00_fr/def_const/$bsa00_amt1",
    "spine_order": "49",
    "value_type": "scalar",
    "unit": "currency/month",
    "threshold_unit": null,
    "label": {
      "en": "Maximum amount for single person without children- FYA (weighted average)"
    },
    "short_label": {
      "en": "$bsa00_amt1"
    },
    "description": {
      "en": "This is the monthly maximum lump-sum amount (montant forfaitaire) of the Revenu de Solidarité Active (RSA, France's main means-tested minimum-income benefit) for a single adult with no dependent children, e.g. EUR 646.52/month in 2025. In the model it is read in the bsa00_fr policy's BenCalc function via the Comp_perTU parameter, which computes the household's maximum RSA entitlement by composition; the RSA benefit paid equals this maximum minus (household quarterly income/3 + a housing package deduction). The 'FYA (weighted average)' tag indicates the constant is a full-year-average value, blending pre- and post-uprating rates (RSA is revalued mid-year, e.g. on 1 April) into a single annual figure used by the model's Full-Year-Average (FYA) extension."
    },
    "explanation": {
      "en": "EUROMOD function group: Parameters for RSA"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
