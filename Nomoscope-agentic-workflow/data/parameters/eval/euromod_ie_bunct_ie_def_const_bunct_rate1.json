    "spine_order": "35",
    "value_type": "scalar",
    "unit": "currency/week",
    "threshold_unit": null,
    "label": {},
    "short_label": {
      "en": "$bunct_Rate1"
    },
    "description": {
      "en": "The lowest of four flat weekly personal rates of Jobseeker's Benefit, paid to claimants whose average weekly earnings in the second-last complete tax year (previous weekly earnings, PWE) were below €150 ($bunct_Thres1). It is set via SchedCalc's band_amount parameter in bunct_ie, which together with $bunct_Thres1-3 implements the four-band graduated personal-rate schedule the Country Report describes as varying 'according to the claimant's average weekly earnings in the second-last complete tax year'. Current value is €114/week; the theme document shows this rate rising from €109.50 in 2025 to €114 in 2026."
    },
    "explanation": {
      "en": "EUROMOD function group: Reduced rates and thresholds"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
