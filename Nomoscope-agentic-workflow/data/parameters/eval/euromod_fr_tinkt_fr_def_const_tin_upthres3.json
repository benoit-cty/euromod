    "model_target": "euromod://FR/tinkt_fr/def_const/$tin_upthres3",
    "spine_order": "28",
    "value_type": "scalar",
    "unit": "currency/year",
    "threshold_unit": null,
    "label": {
      "en": "Upper limit for band 3"
    },
    "short_label": {
      "en": "$tin_upthres3"
    },
    "description": {
      "en": "The upper income ceiling of the 11% bracket (the boundary between the 11% and 30% bands) in the progressive IRPP schedule, despite being labelled \"band 3\" in the model's internal numbering (band 2 being an unused historical slot, see $tin_upthres2). Used as Band_UpLim in tin_fr's and tinkt_fr's SchedCalc for the gross-tax and Imax computations, and matches the €29,579 ceiling shown for the 11% band in the taxes theme doc and the country report's Table 2.77."
    },
    "explanation": {
      "en": "EUROMOD function group: Paramteres of the income tax"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "income_year"
  },
