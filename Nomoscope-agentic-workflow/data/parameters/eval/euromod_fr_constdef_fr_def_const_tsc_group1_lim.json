{
  "information": {
    "country": "FR",
    "model_target": "euromod://FR/ConstDef_fr/def_const/$tsc_group1_lim",
    "spine_order": "3",
    "value_type": "scalar",
    "unit": "currency/month",
    "threshold_unit": null,
    "label": {
      "en": "Income limits for SIC purposes: 1*monthly PSS"
    },
    "short_label": {
      "en": "$tsc_group1_lim"
    },
    "description": {
      "en": "$tsc_group1_lim is the monthly income ceiling defining the top of 'Income Group 1' (non-white-collar employees) for social-insurance-contribution purposes, set equal to 1x the monthly social security ceiling (PSS, 'Plafond de la Securite Sociale'). It is used in tscee_fr/SchedCalc as the upper limit (Band_UpLim) of the band for the non-white-collar complementary pension contribution, and in tscer_fr/BenCalc (Comp_perTU) for the employer's basic old-age insurance contribution. Per tscee.md (Table 2.56), Income group 1 spans 0 to 1x monthly PSS, i.e. 3925 EUR/month in 2025 ('3925=1*monthly PSS'); the constant's latest value of 4005 reflects a further PSS revaluation."
    },
    "explanation": {
      "en": "EUROMOD function group: Income limits for SIC purposes"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
