    "threshold_unit": null,
    "label": {
      "en": "basic allowance: the higher level of basic allowance"
    },
    "short_label": {
      "en": "$tinta_max_amt"
    },
    "description": {
      "en": "Sets the maximum (pre-withdrawal) annual level of the general basic personal-income-tax allowance under the formula in force since 2022 — 8,964 EUR/year (747 EUR/month for 2024-2025), matching the 'General' row of Table 2.16 in the country report and the LT tax summary's statement of a 747 EUR/month basic allowance for residents with income at or below the minimum monthly salary. It is used as the Comp_perTU parameter of the BenCalc components computing the basic allowance in tin_admn_lt ('post 2022 formula') and tin_lt (final tax liability, since 2009); above the income threshold $tinta_higher_thres the allowance is progressively withdrawn at the rate $tinta_basic_WithdRate_Higher."
    },
    "explanation": {
      "en": "EUROMOD function group: personal income tax (PIT): general parameters"
    },
