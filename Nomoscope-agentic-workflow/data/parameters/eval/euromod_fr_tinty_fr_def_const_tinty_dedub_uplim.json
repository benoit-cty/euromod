    "spine_order": "26",
    "value_type": "scalar",
    "unit": "currency/year",
    "threshold_unit": null,
    "label": {
      "en": "Maximum deduction for unemployment benefit"
    },
    "short_label": {
      "en": "$tinty_dedub_uplim"
    },
    "description": {
      "en": "This is the maximum ceiling on the 10% flat-rate deduction applied specifically to unemployment benefit income within category C1 of the French personal income tax, currently set to 0 in the model. It is used in policy tinty_fr in the BenCalc computing 'Tax deductions/allowances for C1 income' as the upper limit (comp_uplim). Neither source document gives a separate published ceiling for unemployment-benefit deductions distinct from the general earned-income ceiling, so the current zero value is inferred from the model rather than directly confirmed by the sources."
    },
    "explanation": {
      "en": "EUROMOD function group: Parameters for determining net taxable income (RNI)"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "income_year"
  },
