    "spine_order": "26",
    "value_type": "scalar",
    "unit": "currency/year",
    "threshold_unit": null,
    "label": {
      "en": "Maximum deduction for unemployment benefit"
    },
    "short_label": {
      "en": "$tinty_dedub_uplim"
    },
    "description": {
      "en": "The ceiling on the deduction applied to unemployment-benefit income, the counterpart to $tinty_dedbun_lowlim; the latest value is €0, meaning the model currently applies no positive deduction cap specific to unemployment benefits. It is used in tinty_fr's BenCalc function (comp_uplim parameter, \"Tax deductions/ allowances for C1 income\"), playing the same structural role as $tinty_ded_maxamt (earnings) and $tinty_dedpens_maxamt (pensions) but for unemployment income. The supplied theme_doc does not break out unemployment benefits from earnings/pensions, so this description is based on name, label and usage context; the 13 recorded historical values indicate the cap changed over time before being zeroed."
    },
    "explanation": {
      "en": "EUROMOD function group: Parameters for determining net taxable income (RNI)"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "income_year"
  },
