    "spine_order": "26",
    "value_type": "scalar",
    "unit": "currency/year",
    "threshold_unit": null,
    "label": {
      "en": "Minimum deduction for pension income"
    },
    "short_label": {
      "en": "$tinty_dedpens_minamt"
    },
    "description": {
      "en": "This is the minimum floor (450 EUR for 2025) on the 10% flat-rate deduction applied to pension income under the French personal income tax, guaranteeing at least this deductible amount per pensioner. It is used in policy tinty_fr in the BenCalc computing 'Tax deductions/allowances for C1 income' as the lower limit (comp_lowlim), specifically for the pension component of category C1. This matches the theme note and the Country Report's Table 2.70, which show the pension deduction floor rising to €450 in 2025 (from €442 in 2024)."
    },
    "explanation": {
      "en": "EUROMOD function group: Parameters for determining net taxable income (RNI)"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "income_year"
  },
