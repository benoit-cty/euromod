{
  "information": {
    "country": "FR",
    "model_target": "euromod://FR/ConstDef_fr/def_const/$tsc_groupB_lim",
    "spine_order": "3",
    "value_type": "scalar",
    "unit": "currency/month",
    "threshold_unit": null,
    "label": {
      "en": "Income limits for SIC purposes: 4*monthly PSS"
    },
    "short_label": {
      "en": "$tsc_groupB_lim"
    },
    "description": {
      "en": "This is an income ceiling for social insurance contribution (SIC) purposes equal to four times the monthly PSS (15,700 EUR/month for 2025/26), corresponding to the 'Tranche B' (cadre/white-collar) contribution band under the French complementary pension system (AGIRC-ARRCO). It is used in tscee_fr/BenCalc (parameter Comp_perElig, the AGFF contribution), tscee_fr/SchedCalc (parameter Band_UpLim, complementary insurance for white-collar employees) and tscer_fr/BenCalc (parameter Comp_perTU, the employer AGFF old-age contribution). This is not covered by the available benefits theme document, but its value (4x the $tsc_group1_lim/$tsc_groupA_lim ceiling) is internally consistent with the model's PSS-based band structure."
    },
    "explanation": {
      "en": "EUROMOD function group: Income limits for SIC purposes"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
