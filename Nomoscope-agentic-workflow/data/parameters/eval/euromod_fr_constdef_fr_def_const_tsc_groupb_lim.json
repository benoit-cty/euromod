{
  "information": {
    "country": "FR",
    "model_target": "euromod://FR/ConstDef_fr/def_const/$tsc_groupB_lim",
    "spine_order": "3",
    "value_type": "scalar",
    "unit": "currency/month",
    "threshold_unit": null,
    "label": {
      "en": "Income limits for SIC purposes: 4*monthly PSS"
    },
    "short_label": {
      "en": "$tsc_groupB_lim"
    },
    "description": {
      "en": "$tsc_groupB_lim is the monthly income ceiling set at 4 times the monthly PSS, the upper bound of 'Income group B', the white-collar counterpart of income group 2, used for SIC purposes. It is the Band_UpLim of the white-collar complementary-pension band ('Complementary insurance for white collar') in tscee_fr/SchedCalc, and it also bounds the AGFF contribution formula (Comp_perElig) in tscee_fr/BenCalc and the employer-side AGFF component (Comp_perTU, 'AGFF (old age)') in tscer_fr/BenCalc. The FR country report (Table 2.56) defines Income group B as 1x to 4x the monthly PSS (2025: 3,925 to 15,700 EUR); the constant's current value (16,020 EUR) implies a later, higher monthly PSS (about 4,005 EUR) than shown in the report."
    },
    "explanation": {
      "en": "EUROMOD function group: Income limits for SIC purposes"
    },
    "last_confirmed_valid_on": null,
    "temporal_basis": "in_force"
  },
